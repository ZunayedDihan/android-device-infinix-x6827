# Product properties for Infinix X6827 (LineageOS 19.1/ Android 12)

# Display and UI
os.charging_animation_type=3 # Potentially affects charging animation, keep if you want it
os.notch.support=2 # Essential for notch handling on your device
qemu.hw.mainkeys=0 # On-screen navigation keys

# Dalvik VM / Memory (General Android properties)
persist.sys.dalvik.vm.lib.2=libart.so # Ensures ART is used

# Telephony / SIM configuration
persist.radio.multisim.config=tsts # Triple SIM Triple Standby
persist.vendor.radio.msimmode=tsts # Triple SIM mode
persist.vendor.radio.tsd.multisimmode=2 # Triple SIM mode
ro.telephony.sim.count=3 # Number of SIM slots
telephony.active_modems.max_count=3 # Max active modems for 3 SIMs

# External Storage (SD Card)
external_storage.casefold.enabled=1
external_storage.projid.enabled=1

# Android Core Features
ro.com.google.acsa=true
ro.com.google.clientidbase=android-transsion
ro.com.google.clientidbase.vs=android-transsion
ro.com.google.gmsversion=12_202210
ro.opa.eligible_device=true # Important for Google Assistant eligibility
setupwizard.theme=glif_v3_light # Standard setup wizard theme

# Fingerprint Sensor
ro.fingerprint_support=1
ro.faceid.support=1 # Keep if device has face unlock and you want it to work
ro.faceid.version=2
ro.faceid.applock.unsupport=1 # This might be important if OEM face unlock handles app lock directly
ro.faceid.low_battery_light=1
ro.fingerprint_wakeup_performance_opt=1
ro.side_fingerprint_support=1

# Thermal / Performance
ro.surface_flinger.set_idle_timer_ms=1200
sys.surfaceflinger.idle_reduce_framerate_enable=yes

# Other potentially useful/generic properties
ro.boot.product.hardware.sku=tsts
ro.product.freezer=false
ro.setupwizard.rotation_locked=true
ro.tapping_wake_support=1 # Tap to wake
ro.virtual_ab.compression.enabled=true # Virtual A/B compression
ro.virtual_ab.userspace.snapshots.enabled=true # Virtual A/B userspace snapshots